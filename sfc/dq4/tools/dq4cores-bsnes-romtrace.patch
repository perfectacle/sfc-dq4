@@ -2,6 +2,18 @@
 
 namespace SuperFamicom {
 
+//libretro memory id 0x5244: one bit per program ROM byte read through the bus, until the front end clears it
+auto romTrace(unsigned* size) -> uint8* {
+  static vector<uint8> bits;
+  *size = (cartridge.rom.size() + 7) / 8;
+  if(bits.size() != *size) {
+    bits.resize(*size);
+    for(auto& b : bits) b = 0;
+  }
+  cartridge.rom.trace = bits.data();
+  return bits.data();
+}
+
