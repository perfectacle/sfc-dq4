@@ -2,6 +2,23 @@
 
 namespace SuperFamicom {
 
+//libretro memory id 0x5244: one bit per program ROM byte read through the bus.
+//only asking for the data turns tracing on; it stays on until the game's ROM is reallocated or freed
+auto romTraceSize() -> unsigned {
+  return (cartridge.rom.size() + 7) / 8;
+}
+
+auto romTraceStart() -> uint8* {
+  static vector<uint8> bits;
+  cartridge.rom.trace = nullptr;
+  unsigned size = romTraceSize();
+  if(!size) return nullptr;
+  if(bits.size() != size) bits.resize(size);
+  for(auto& b : bits) b = 0;
+  cartridge.rom.trace = bits.data();
+  return bits.data();
+}
+
 #include "load.cpp"
 #include "save.cpp"
 #include "serialization.cpp"
